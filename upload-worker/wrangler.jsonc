{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "verkiezingswinnaar-r2-upload",
  "main": "src/index.js",
  "compatibility_date": "2026-09-28",
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "FEED_BUCKET",
      "bucket_name": "verkiezingswinnaar"
    }
  ],
  "observability": {
    "logs": {
      "enabled": false
    }
  }
}
